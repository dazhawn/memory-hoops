# Copy to android/keystore.properties and fill in. That file is gitignored —
# it must never be committed, and neither must the .jks itself.
#
# Generate the keystore first (see RELEASE_SIGNING.md):
#   keytool -genkeypair -v -keystore memory-hoops-upload.jks \
#     -alias memory-hoops -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the android/app directory, so a path outside
# the repo is fine and is the safer choice. Use forward slashes on Windows too.

storeFile=C:/Users/you/keys/memory-hoops-upload.jks
storePassword=
keyAlias=memory-hoops
keyPassword=

# CI alternative — set these environment variables instead of using this file:
#   MH_KEYSTORE_FILE, MH_KEYSTORE_PASSWORD, MH_KEY_ALIAS, MH_KEY_PASSWORD
# Optional version overrides (Play rejects a repeated versionCode):
#   MH_VERSION_CODE, MH_VERSION_NAME
